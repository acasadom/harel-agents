bind {
  research_topic = research_agent.actions.research_topic
}

machine sub_researcher {
  context {
    topic:    string
    question: string
    feedback: string?
  }
  carry summary, _error

  initial Searching

  state Searching {
    on enter research_topic
  }

  final Done   success {}
  final Failed failed  {}

  from Searching to Done
  from Searching to Failed on error where type == "ProviderError"
}
