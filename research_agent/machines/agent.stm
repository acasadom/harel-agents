event Approved {}
event RequestRevision {}

bind {
  plan_research  = research_agent.actions.plan_research
  grade_research = research_agent.actions.grade_research
  draft_answer   = research_agent.actions.draft_answer
}

machine research_agent {
  context {
    question:       string
    num_topics:     int = 3
    retries:        int = 0
    max_retries:    int = 2
    sub_topics:     any?
    grade:          string?
    grade_feedback: string?
    provider_name:  string?
    model:          string?
  }

  initial Planning

  state Planning {
    on enter plan_research
  }

  state Researching {
    invoke sub_researcher for topic in sub_topics
    with { topic: topic question: question feedback: grade_feedback }
  }

  state Grading {
    on enter grade_research
  }

  state Drafting {
    on enter draft_answer
  }

  state HumanReview {
    timeout 86400
  }

  final Done   success {}
  final Failed failed  {}

  from Planning to Researching
  from Planning to Failed on error where type == "ProviderError"

  from Researching join any to Grading else to Failed

  from Grading choose {
    when context.grade == "insufficient" and context.retries < context.max_retries
      to Researching set context.retries = context.retries + 1
    else to Drafting
  }
  from Grading to Failed on error where type == "ProviderError"

  from Drafting choose {
    when context.grade == "complete" to Done
    else to HumanReview
  }
  from Drafting to Failed on error where type == "ProviderError"

  from HumanReview to Done     on Approved
  from HumanReview to Drafting on RequestRevision
  from HumanReview to Failed   on Timeout
}
